\begin{figure}
  \includegraphics[width=\columnwidth]{../../plots/cal-eng.pdf}
  \caption{Gradual alignment of state and federal electoral calendars 1994--2026. The X-axis measures time, with ticks corresponding to January 1 of each year. Vertical black lines indicate the dates of federal races, solid lines for general elections, dotted lines for midterm elections. Circumferences indicate when state elections took place, colored as indicated in the top legend.}\label{F:cal}
  % \alt={Alignment of state electoral calendars with federal elections, showing that the relative timing of gubernatorial, state assembly, and municipal elections varied substantially across states at the beginning of the period, but this variation largely disappeared as states increasingly aligned their electoral calendars with the federal cycle.}
\end{figure}
