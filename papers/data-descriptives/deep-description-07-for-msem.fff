\begin{figure}
  \centering
  \includegraphics[width=.6\columnwidth]{../../plots/triplot1989-2014-v-mu.pdf}
  \caption{Predominantly bipartisan rivalries before Morena. The ternary plot reports the share of the three-party vote that major parties won in municipal elections in the 1989--2014 period (excluding the Federal District). Points inside the dotted area are marginal municipalities, where the difference between the top-two parties was 10 percentage points or less.}\label{F:triplot}
  % \alt={Distribution of municipal elections within a triangular plot: a large proportion of races lie along the triangle's sides, indicating that one of the three parties received no votes, or within bands representing margins of victory of 10 percentage points or less.}
\end{figure}
